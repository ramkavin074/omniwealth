{
  "name": "omniwealth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "stocking:dev": "vite --config stocking-standalone/vite.config.ts",
    "stocking:build": "vite build --config stocking-standalone/vite.config.ts",
    "stocking:cap": "node scripts/with-stocking-capacitor.mjs",
    "stocking:add-android": "node scripts/with-stocking-capacitor.mjs add android",
    "stocking:sync": "npm run stocking:build && node scripts/with-stocking-capacitor.mjs sync android",
    "stocking:apk": "npm run stocking:sync && cd android-stocking && gradlew.bat assembleDebug",
    "stocking:add-ios": "node scripts/with-stocking-capacitor.mjs add ios",
    "stocking:sync-ios": "npm run stocking:build && node scripts/with-stocking-capacitor.mjs sync ios",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.1",
    "@google/genai": "^2.18.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.72.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.0.7"
  }
}
