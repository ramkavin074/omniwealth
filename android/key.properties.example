# Copy to android/key.properties (git-ignored) and fill in with your
# Play upload keystore details. build.gradle reads this for release signing;
# without it, release builds fall back to debug signing.
#
# storeFile is resolved relative to the android/ directory.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
